# Copy to .env and replace every "change-me" value:   cp .env.example .env
# .env is git-ignored. Nothing in this file is a real secret.

# --- Postgres (n8n's database + the alert log) ---
POSTGRES_USER=dataops
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_HOST_PORT=5433

# --- n8n ---
# Encrypts credentials stored by n8n. Generate one with:  openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me-run-openssl-rand-hex-32
N8N_PORT=5678
GENERIC_TIMEZONE=Asia/Kolkata

# Basic auth that senders (Databricks, Azure Monitor, the simulator) use on the n8n webhooks
ALERT_WEBHOOK_USER=alert-sender
ALERT_WEBHOOK_PASSWORD=change-me-webhook-password

# --- Routing behaviour ---
DEDUP_WINDOW_MINUTES=15

# --- Slack: defaults to the local mock receiver. For real Slack use an incoming-webhook URL. ---
SLACK_WEBHOOK_URL=http://mock-receiver:8000/slack/webhook

# --- Jira: defaults to the local mock receiver (it accepts any user/token). ---
# For Jira Cloud: JIRA_BASE_URL=https://<your-site>.atlassian.net, your account email and an API token.
JIRA_BASE_URL=http://mock-receiver:8000
JIRA_PROJECT_KEY=DATA
JIRA_ISSUE_TYPE=Bug
JIRA_USER_EMAIL=mock-user@example.com
JIRA_API_TOKEN=change-me-mock-accepts-any-token

# --- Email: defaults to Mailpit (catches all mail, UI on http://localhost:8025) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_DISABLE_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=dataops-alerts@example.com
ONCALL_EMAIL_TO=oncall-data@example.com
DIGEST_EMAIL_TO=data-team@example.com
PLATFORM_EMAIL_TO=data-platform@example.com

# --- Optional LLM summary node (disabled in the workflow by default) ---
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# --- Host ports for the demo services ---
MAILPIT_UI_PORT=8025
MOCK_RECEIVER_PORT=8000

# --- Optional: pre-create the local n8n owner so the editor opens without the setup screen ---
# Not needed for the webhooks or the simulator. Hash a password of your choice with:
#   docker run --rm -w /usr/local/lib/node_modules/n8n --entrypoint node n8nio/n8n:2.45.7 \
#     -e "process.stdout.write(require('bcryptjs').hashSync(process.argv[1], 10))" 'YourPassw0rd'
# and paste it in SINGLE quotes (the hash contains $ signs that compose would otherwise expand).
N8N_INSTANCE_OWNER_MANAGED_BY_ENV=false
N8N_INSTANCE_OWNER_EMAIL=
N8N_INSTANCE_OWNER_PASSWORD_HASH=
# Plain password, read only by scripts/screenshot_canvas.py
N8N_UI_LOGIN_PASSWORD=
